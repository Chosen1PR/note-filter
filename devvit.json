{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "note-filter",
  "permissions": {
    "http": {
      "enable": false
    },
    "media": false,
    "realtime": false,
    "redis": true,
    "reddit": {
      "enable": true
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "settings": {
    "subreddit": {
      "actionPosts": {
        "type": "boolean",
        "label": "Action posts",
        "helpText": "If enabled, the app will action posts from users with a note on their account.",
        "defaultValue": true
      },
      "actionComments": {
        "type": "boolean",
        "label": "Action comments",
        "helpText": "If enabled, the app will action comments from users with a note on their account.",
        "defaultValue": true
      },
      "spamWatchBehavior": {
        "type": "select",
        "label": "Behavior for users with a \"Spam Watch\" note",
        "helpText": "\"Report\" will flag content for review without removing it. \"Filter\" will remove content and send it for review. \"Remove\" will remove content without sending it for review.",
        "defaultValue": "report",
        "options": [
          {
            "label": "No action",
            "value": "none"
          },
          {
            "label": "Report",
            "value": "report"
          },
          {
            "label": "Filter",
            "value": "filter"
          },
          {
            "label": "Remove",
            "value": "remove"
          }
        ]
      },
      "spamWarningBehavior": {
        "type": "select",
        "label": "Behavior for users with a \"Spam Warning\" note",
        "defaultValue": "filter",
        "options": [
          {
            "label": "No action",
            "value": "none"
          },
          {
            "label": "Report",
            "value": "report"
          },
          {
            "label": "Filter",
            "value": "filter"
          },
          {
            "label": "Remove",
            "value": "remove"
          }
        ]
      },
      "abuseWarningBehavior": {
        "type": "select",
        "label": "Behavior for users with an \"Abuse Warning\" note",
        "defaultValue": "filter",
        "options": [
          {
            "label": "No action",
            "value": "none"
          },
          {
            "label": "Report",
            "value": "report"
          },
          {
            "label": "Filter",
            "value": "filter"
          },
          {
            "label": "Remove",
            "value": "remove"
          }
        ]
      },
      "banNoteBehavior": {
        "type": "select",
        "label": "Behavior for users with a \"Ban\" note",
        "defaultValue": "filter",
        "options": [
          {
            "label": "No action",
            "value": "none"
          },
          {
            "label": "Report",
            "value": "report"
          },
          {
            "label": "Filter",
            "value": "filter"
          },
          {
            "label": "Remove",
            "value": "remove"
          }
        ]
      },
      "noLabelBehavior": {
        "type": "select",
        "label": "Behavior for users with a standard note (no label)",
        "defaultValue": "none",
        "options": [
          {
            "label": "No action",
            "value": "none"
          },
          {
            "label": "Report",
            "value": "report"
          },
          {
            "label": "Filter",
            "value": "filter"
          },
          {
            "label": "Remove",
            "value": "remove"
          }
        ]
      },
      "noLabelKeywords": {
        "type": "paragraph",
        "label": "Keywords for notes with no label",
        "helpText": "Comma (,) separated list of keywords or phrases to check for in notes with no label. If left blank, every note will be considered.",
        "defaultValue": ""
      },
      "maxNoteAgeDays": {
        "type": "number",
        "label": "Ignore notes older than ___ days",
        "helpText": "Ignore mod notes older than a certain amount of days. Set to 0 or less to respect all notes.",
        "defaultValue": 0
      },
      "exemptApproved": {
        "type": "boolean",
        "label": "Exempt approved users",
        "helpText": "If enabled, the app will not action content from users who have been approved by mods.",
        "defaultValue": false
      }
    }
  },
  "triggers": {
    "onPostCreate": "/internal/triggers/on-post-create",
    "onCommentCreate": "/internal/triggers/on-comment-create"
  },
  "marketingAssets": {
    "icon": "assets/nf-icon.png"
  },
  "dev": {
    "subreddit": "CapitalOneBank"
  }
}